{
    "name": "equo/backend",
    "description": "Backend application for Equo.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/amqp-messenger": "7.4.*",
        "symfony/cache": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/password-hasher": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/redis-messenger": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "policy": {
            "abandoned": {
                "audit": "fail"
            }
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "analyse": [
            "@php bin/console cache:warmup --env=test --no-interaction",
            "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=512M"
        ],
        "check": [
            "@check:composer",
            "@check:style",
            "@analyse",
            "@check:symfony"
        ],
        "check:autoload": "@composer dump-autoload --optimize --strict-psr --strict-ambiguous --no-interaction --no-scripts",
        "check:composer": [
            "@composer validate --strict --no-check-publish",
            "@check:autoload"
        ],
        "check:migrations": [
            "@php bin/console doctrine:migrations:migrate --env=test --no-interaction --allow-no-migration",
            "@php bin/console doctrine:migrations:up-to-date --env=test --no-interaction",
            "@php bin/console doctrine:migrations:status --env=test --no-interaction",
            "@php bin/console doctrine:schema:validate --env=test"
        ],
        "check:style": "php-cs-fixer check --config=.php-cs-fixer.dist.php --diff --show-progress=none",
        "check:symfony": [
            "@php bin/console lint:container --env=test",
            "@php bin/console lint:yaml config",
            "@php bin/console debug:router --env=test --show-controllers",
            "@php bin/console doctrine:schema:validate --env=test --skip-sync"
        ],
        "fix:style": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --show-progress=none",
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "@php bin/phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    }
}
