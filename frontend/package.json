{
  "name": "equo-frontend",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "check": "npm run check:lock && npm run lint && npm run typecheck && npm test && npm run build",
    "check:lock": "npm ci --dry-run --ignore-scripts --no-audit",
    "check:quality": "npm run check:lock && npm run lint && npm run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:component",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "node scripts/patch-nitropack.mjs"
  },
  "dependencies": {
    "nuxt": "4.5.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "happy-dom": "20.11.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "nitropack": {
      "archiver": "8.0.0"
    }
  },
  "engines": {
    "node": ">=22 <23"
  }
}
