{
  "name": "equo-frontend",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "check": "npm run check:lock && npm run lint && npm run typecheck && npm test && npm run build",
    "check:lock": "npm ci --dry-run --ignore-scripts --no-audit",
    "check:quality": "npm run check:lock && npm run lint && npm run typecheck",
    "audit": "node scripts/audit-dependencies.mjs",
    "lint": "eslint . --max-warnings=0 && npm run lint:ui",
    "lint:ui": "node scripts/check-ui-system.mjs",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:component",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "node scripts/patch-nitropack.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@remixicon/vue": "^4.9.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "nuxt": "4.6.2",
    "reka-ui": "^2.11.0",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.44",
    "vue-multiselect": "3.5.0",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "happy-dom": "21.0.4",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "nitropack": {
      "archiver": "8.0.0"
    }
  },
  "engines": {
    "node": ">=22 <23"
  }
}
