map $uri $safe_request_path {
    default $uri;
    ~^/(api/v1/)?connect-invitations/ /connect-invitations/[redacted];
}

upstream php_fpm { server backend:9000; }
upstream nuxt { server frontend:3000; }
log_format safe_request '$remote_addr $request_method $safe_request_path $status';

server {
    listen 80;
    server_name ${APP_HOST};
    access_log /var/log/nginx/access.log safe_request;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 308 https://${APP_HOST}$request_uri; }
}

server {
    listen 443 ssl;
    # Container-network only: SSR and readiness use the same upstream routing.
    listen 8080;
    server_name ${APP_HOST};
    ssl_certificate /etc/letsencrypt/live/${APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /var/log/nginx/access.log safe_request;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location = /api/v1/connect-invitations {
        root /var/www/backend/public;
        try_files $uri /index.php$is_args$args;
    }
    location ^~ /api/v1/connect-invitations/ {
        error_log /dev/null;
        root /var/www/backend/public;
        include fastcgi_params;
        fastcgi_pass php_fpm;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_HOST ${APP_HOST};
        fastcgi_param HTTP_X_REAL_IP $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
    }
    location ^~ /connect-invitations/ {
        error_log /dev/null;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Cache-Control;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control no-store always;
        proxy_pass http://nuxt;
        proxy_set_header Host ${APP_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location ^~ /api/ {
        root /var/www/backend/public;
        try_files $uri /index.php$is_args$args;
    }
    location ~ ^/index\.php(/|$) {
        root /var/www/backend/public;
        include fastcgi_params;
        fastcgi_pass php_fpm;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_HOST ${APP_HOST};
        fastcgi_param HTTP_X_REAL_IP $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        internal;
    }
    location / {
        proxy_pass http://nuxt;
        proxy_set_header Host ${APP_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
