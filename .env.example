# Local development only. Never use these credentials or keys in a deployment.
APP_ENV=dev
APP_SECRET=local-development-secret
APP_PORT=80
POSTGRES_DB=equo
POSTGRES_USER=equo
POSTGRES_PASSWORD=equo
BACKEND_DATABASE_URL=postgresql://equo:equo@postgres:5432/equo?serverVersion=17&charset=utf8
BACKEND_REDIS_URL=redis://redis:6379
BACKEND_MESSENGER_TRANSPORT_DSN=amqp://equo:equo@rabbitmq:5672/%2f/messages
BACKEND_MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=no-reply@equo.local
DEFAULT_URI=http://localhost
FRONTEND_BASE_URL=http://localhost
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=equo
RABBITMQ_DEFAULT_PASS=equo
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
NUXT_PUBLIC_API_BASE=/api
NUXT_API_INTERNAL_BASE=http://nginx/api
EQUO_REGISTRATION_IP_LIMIT=5
EQUO_REGISTRATION_EMAIL_LIMIT=3
EQUO_ACTIVATION_REQUEST_IP_LIMIT=20
EQUO_ACTIVATION_REQUEST_EMAIL_LIMIT=3
EQUO_ACTIVATION_IP_LIMIT=10
EQUO_ACTIVATION_TOKEN_LIMIT=5
EQUO_LOGIN_FAILURE_LIMIT=5
EQUO_JWT_SIGNING_KEY_VERSION=v1
EQUO_JWT_SIGNING_PRIVATE_KEY=base64-encoded-rsa-private-key-placeholder
EQUO_JWT_PUBLIC_KEY_RING='{"v1":"base64-encoded-rsa-public-key-placeholder"}'
EQUO_JWT_ISSUER=https://equo.local
EQUO_JWT_AUDIENCE=equo-api
EQUO_JWT_ACCESS_TTL_SECONDS=900
EQUO_JWT_CLOCK_SKEW_SECONDS=30
EQUO_CSRF_SIGNING_KEY_VERSION=v1
EQUO_CSRF_SIGNING_KEY_RING='{"v1":"base64-encoded-32-byte-csrf-key-placeholder"}'
EQUO_APPLICATION_ORIGIN=http://localhost

# Development/test-only sample keys. Generate distinct keys for every deployment.
ACTION_TOKEN_ACTIVE_VERSION=v1
ACTION_TOKEN_HMAC_KEYS='{"v1":"YWN0aW9uLXRva2VuLWRldi1rZXktMzItYnl0ZXMhISE="}'
IDEMPOTENCY_FINGERPRINT_ACTIVE_VERSION=v1
IDEMPOTENCY_FINGERPRINT_HMAC_KEYS='{"v1":"aWRlbXBvdGVuY3ktZmluZ2VycHJpbnQtZGV2LWtleS0zMiEh"}'
EMAIL_PAYLOAD_KEY=ZW1haWwtcGF5bG9hZC1kZXYta2V5LTMyLWJ5dGVzISE=

# Development/test-only invitation key. Production must configure its own key ring.
EQUO_INVITATION_SIGNING_VERSION=v1
EQUO_INVITATION_SIGNING_KEYS='{"v1":"ZGV2LW9ubHktaW52aXRhdGlvbi1zaWduaW5nLWtleS0zMi1ieXRlcw=="}'
